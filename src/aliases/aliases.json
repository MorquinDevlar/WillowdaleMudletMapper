[
    {
        "name": "mapper",
        "isActive": "yes",
        "regex": "^mapper(?: (.+))?$",
        "script": "mapper.commands.dispatch(matches[2])",
        "isFolder": "no"
    },
    {
        "name": "mconfig",
        "isActive": "yes",
        "regex": "^mconfig(?: (.+))?$",
        "script": "mapper.commands.config(matches[2])",
        "isFolder": "no"
    },
    {
        "name": "mstop",
        "isActive": "yes",
        "regex": "^mstop$",
        "script": "mapper.stop()",
        "isFolder": "no"
    },
    {
        "name": "showpath",
        "isActive": "yes",
        "regex": "^showpath(?: (.+))?$",
        "script": "mapper.commands.path(matches[2])",
        "isFolder": "no"
    }
]
